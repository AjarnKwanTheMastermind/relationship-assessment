# PostgreSQL connection (matches `npm run db:dev` and docker-compose.yml)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/relationship_audit

# Password for /admin (username: admin). /admin stays locked while this is empty.
ADMIN_PASSWORD=

# Set to `on` to close the public site with a Thai maintenance page (503). The backoffice stays reachable.
# Leave empty for normal operation. In production it is changed in Netlify and needs a new deploy.
MAINTENANCE_MODE=

# Email notification to the administrator whenever a setting is changed (optional; sent through Resend).
# Without all three, saving still works and the settings page says no email was sent.
ADMIN_EMAIL=
RESEND_API_KEY=
EMAIL_FROM=

# Two-factor authentication for settings changes. Set to `on` and every save asks for a one-time password
# emailed to ADMIN_EMAIL instead of the administrator password. Needs the three email variables above.
# Leave empty to ask for the administrator password. In production it is changed in Netlify and needs a new deploy.
TWO_FACTOR_AUTHEN=
# Optional limits for the one-time password (defaults: 10 minutes, 5 tries per code, 3 requests per 15 minutes).
OTP_TTL_MINUTES=
OTP_MAX_ATTEMPTS=
OTP_MAX_REQUESTS=
OTP_REQUEST_WINDOW_MINUTES=

# Limit on wrong administrator passwords on the settings forms (used while TWO_FACTOR_AUTHEN is off).
# After PASSWORD_MAX_ATTEMPTS wrong tries (default 5), saving is locked for PASSWORD_LOCK_MINUTES (default 15),
# and the administrator is emailed once. The same minutes are the window in which tries are counted.
PASSWORD_MAX_ATTEMPTS=
PASSWORD_LOCK_MINUTES=

# Limit on wrong passwords at the backoffice login prompt. After LOGIN_MAX_ATTEMPTS wrong tries (default 10) the
# login is locked for everyone for LOGIN_LOCK_MINUTES (default 15) and the administrator is emailed once.
LOGIN_MAX_ATTEMPTS=
LOGIN_LOCK_MINUTES=

# Limits on saving quizzes: per address and per minute (default 10), and for the whole site per minute (default 120).
QUIZ_IP_LIMIT_PER_MINUTE=
RESPONSES_PER_MINUTE=

# The address of the site, for the text of the emails (for example https://your-site.netlify.app). Without it the
# URL that Netlify provides is used.
SITE_URL=

# A long random value that keys the one-time password hashes. Optional: without it the admin password is used.
# Changing it cancels any code that is waiting.
OTP_SECRET=
