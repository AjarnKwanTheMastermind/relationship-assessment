# PostgreSQL connection (matches `npm run db:dev` and docker-compose.yml)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/relationship_audit

# Password for /admin (username: admin). /admin stays locked while this is empty.
ADMIN_PASSWORD=

# Email address that receives the one-time password (OTP) for changing settings in /backoffice/settings.
# Keep it here, not in the app: whoever can edit it can receive the codes. Saving settings is blocked while it is empty.
ADMIN_EMAIL=

# Email service used to send the OTP (Resend). Both are required in production.
# In development, leave them empty: the OTP is shown on the verification page and printed in the server log.
RESEND_API_KEY=
EMAIL_FROM=
